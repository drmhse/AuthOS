{
  "name": "@drmhse/authos-node",
  "version": "0.8.0",
  "description": "Pre-1.0 Node.js adapter for AuthOS Express middleware and token verification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" tsdown.config.mjs --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authos",
    "auth",
    "authentication",
    "node",
    "express",
    "middleware",
    "jwt",
    "jwks"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "MIT",
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "@drmhse/sso-sdk": "0.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "express": "^4.22.3",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git",
    "directory": "packages/authos-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
