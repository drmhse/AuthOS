{
  "name": "@drmhse/authos-vue",
  "version": "0.8.0",
  "description": "Pre-1.0 Vue and Nuxt adapter for AuthOS authentication",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt.d.mts",
        "default": "./dist/nuxt.mjs"
      },
      "require": {
        "types": "./dist/nuxt.d.ts",
        "default": "./dist/nuxt.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsdown --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" tsdown.config.mjs --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authos",
    "auth",
    "authentication",
    "vue",
    "nuxt",
    "oauth",
    "sso"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "MIT",
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "nuxt": ">=3.0.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.8",
    "@types/node": "^25.0.3",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git",
    "directory": "packages/authos-vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@drmhse/sso-sdk": "0.8.0"
  }
}
