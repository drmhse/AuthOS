{
  "name": "@drmhse/authos-cli",
  "version": "0.8.0",
  "description": "Pre-1.0 CLI for scaffolding AuthOS integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "authos": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" tsdown.config.mjs --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authos",
    "auth",
    "authentication",
    "cli",
    "scaffold",
    "react",
    "vue",
    "nextjs",
    "nuxt"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "MIT",
  "dependencies": {
    "@drmhse/sso-sdk": "0.8.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git",
    "directory": "packages/authos-cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
