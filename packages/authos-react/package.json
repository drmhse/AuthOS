{
  "name": "@drmhse/authos-react",
  "version": "0.8.0",
  "description": "Pre-1.0 React and Next.js adapter for AuthOS authentication",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/nextjs.d.mts",
        "default": "./dist/nextjs.mjs"
      },
      "require": {
        "types": "./dist/nextjs.d.ts",
        "default": "./dist/nextjs.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" tsdown.config.mjs --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authos",
    "auth",
    "authentication",
    "react",
    "nextjs",
    "oauth",
    "sso"
  ],
  "author": "DRM HSE <info@drmhse.com>",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drmhse/AuthOS.git",
    "directory": "packages/authos-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@drmhse/sso-sdk": "0.8.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
